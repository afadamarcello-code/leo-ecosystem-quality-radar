model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Customer_Service","Customers","Dim_Issue","_Measures"]

ref table Customer_Service
ref table Customers
ref table Dim_Issue
ref table Dim_Date
ref table _Measures

ref cultureInfo en-US

