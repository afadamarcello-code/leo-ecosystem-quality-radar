	column 'Response Bucket' =
			
			SWITCH (
			    TRUE (),
			    Customer_Service[First_Response_Minutes] <= 10, "0-10 min",
			    Customer_Service[First_Response_Minutes] <= 20, "10-20 min",
			    Customer_Service[First_Response_Minutes] <= 30, "20-30 min",
			    Customer_Service[First_Response_Minutes] <= 60, "30-60 min",
			    "60+ min"
			)
		lineageTag: c5cb649a-4b2a-4cd7-aaf9-a2600a855785
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Resolution Bucket' =
			
			SWITCH (
			    TRUE (),
			    Customer_Service[Resolution_Hours] <= 6, "0-6 h",
			    Customer_Service[Resolution_Hours] <= 12, "6-12 h",
			    Customer_Service[Resolution_Hours] <= 24, "12-24 h",
			    Customer_Service[Resolution_Hours] <= 48, "24-48 h",
			    "48+ h"
			)
		lineageTag: 3fa321b4-409f-439c-a1ae-8c13617a1371
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

